# ---- Build stage ----
FROM golang:1.26-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /out/tmdb-sync ./cmd/tmdb-sync

# ---- Final stage ----
FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app

COPY --from=builder /out/tmdb-sync .

USER nonroot:nonroot

EXPOSE 8082

ENTRYPOINT ["/app/tmdb-sync"]
